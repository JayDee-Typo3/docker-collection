# Immich version (leave empty to use 'release')
IMMICH_VERSION=

# Machine Learning
# Set to false to disable ML entirely (saves ~1-2 GB RAM, loses smart search & face detection)
MACHINE_LEARNING_ENABLED=
# Number of ML workers (set to 1 on low-RAM devices like Pi 4)
MACHINE_LEARNING_WORKERS=
# Seconds before an idle worker is stopped to free RAM
MACHINE_LEARNING_WORKER_TIMEOUT=
# CPU threads used per model run — lower = less RAM/CPU pressure
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=

# Upload location for media files on the host
UPLOAD_LOCATION=

# Database storage location on the host
DB_DATA_LOCATION=

# PostgreSQL credentials
DB_PASSWORD=
DB_USERNAME=
DB_DATABASE_NAME=
